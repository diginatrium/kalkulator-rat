{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "firebase@firebase": false,
    "firebase@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/test-on-edit.js",
            "blocking": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),d=new Date().toLocaleDateString('en-CA'),p='C:/Users/Wiktor/Desktop/Claude/kalkulator-rat/.agents/handoffs/'+d+'.md';if(!fs.existsSync(p)){console.log('\\u26a0\\ufe0f  No handoff for '+d+'. Run /handoff before closing the session.');process.exit(1)}\"",
            "blocking": true
          }
        ]
      }
    ]
  }
}
